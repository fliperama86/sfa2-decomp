+/* The picture filter of the SFA2 port: 0 nearest, 1 bilinear (one linear blit),
+ * 2 sharp bilinear (whole-factor nearest enlargement into this texture, then
+ * one linear stretch to the window). */
+static int sfa2_filter;
+static SDL_GPUTexture* sfa2_sharp_texture;
+static Uint32 sfa2_sharp_w, sfa2_sharp_h;
+void Psyz_Sfa2SetFilter(int filter) { sfa2_filter = filter == 1 || filter == 2 ? filter : 0; }
+static int Sfa2SharpPrescale(SDL_GPUCommandBuffer* cmd, SDL_GPUBlitRegion* src, SDL_Rect dst) {
+    struct port_video_view pre;
+    if (sfa2_filter != 2 || debug_show_vram ||
+        !port_video_sharp_fit((int)src->w,(int)src->h,dst.w,dst.h,&pre)) return 0;
+    if (!sfa2_sharp_texture || sfa2_sharp_w != (Uint32)pre.w || sfa2_sharp_h != (Uint32)pre.h) {
+        const SDL_GPUTextureCreateInfo info = {
+            .type = SDL_GPU_TEXTURETYPE_2D,
+            .format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM,
+            .usage = SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | SDL_GPU_TEXTUREUSAGE_SAMPLER,
+            .width = (Uint32)pre.w,
+            .height = (Uint32)pre.h,
+            .layer_count_or_depth = 1,
+            .num_levels = 1,
+        };
+        if (sfa2_sharp_texture) SDL_ReleaseGPUTexture(device, sfa2_sharp_texture);
+        sfa2_sharp_texture = SDL_CreateGPUTexture(device, &info);
+        sfa2_sharp_w = (Uint32)pre.w;
+        sfa2_sharp_h = (Uint32)pre.h;
+        if (!sfa2_sharp_texture) return 0; /* nearest, as with the setting off */
+        printf("sharp-bilinear: picture %ux%u, nearest to %dx%d, linear to %dx%d\n",(unsigned)src->w,(unsigned)src->h,pre.w,pre.h,dst.w,dst.h);
+        fflush(stdout);
+    }
+    if (!sfa2_sharp_texture) return 0;
+    const SDL_GPUBlitInfo enlarge = {
+        .source = *src,
+        .destination = {.texture = sfa2_sharp_texture, .w = (Uint32)pre.w, .h = (Uint32)pre.h},
+        .load_op = SDL_GPU_LOADOP_DONT_CARE,
+        .filter = SDL_GPU_FILTER_NEAREST,
+        .cycle = true,
+    };
+    SDL_BlitGPUTexture(cmd, &enlarge);
+    *src = (SDL_GPUBlitRegion){.texture = sfa2_sharp_texture, .w = (Uint32)pre.w, .h = (Uint32)pre.h};
+    return 1;
+}
+/* The screen of the SFA2 port (Psyz_Sfa2SetScreen): 0 window, 1 exclusive fullscreen, 2 borderless fullscreen. Before the window is shown the
+ * request is only kept; sfa2_win_* is the window's inner size and sfa2_fs_* the mode asked for (0, 0: the desktop's). is_fullscreen (PsyZ's own
+ * flag) follows every change, so that PsyZ's F4 works from any state. */
+#ifndef PLATFORM_IOS
+static int sfa2_screen, sfa2_screen_set;
+static int sfa2_win_w = DEFAULT_FRONT_W, sfa2_win_h = DEFAULT_FRONT_H;
+static int sfa2_fs_w, sfa2_fs_h;
+static SDL_DisplayID Sfa2Display(void) {
+    SDL_DisplayID id = SDL_GetDisplayForWindow(sdl3_window);
+    return id ? id : SDL_GetPrimaryDisplay();
+}
+/* Put the existing window in the screen. `shown` is 0 while the window is still hidden (SDL then only keeps the request). 0, or -1 with the
+ * window as it was. */
+static int Sfa2ApplyScreen(int screen, int w, int h, int shown) {
+    if (screen == 0) {
+        if (is_fullscreen) {
+            if (!SDL_SetWindowFullscreen(sdl3_window, false)) {
+                WARNF("screen: cannot leave fullscreen: %s", SDL_GetError());
+                return -1;
+            }
+            if (shown) SDL_SyncWindow(sdl3_window);
+            is_fullscreen = false;
+        }
+        SetWindowSizeInPixels(w, h);
+        if (shown) {
+            SDL_SyncWindow(sdl3_window);
+            SDL_GetWindowSizeInPixels(sdl3_window, &wnd_size_in_pixels.w, &wnd_size_in_pixels.h);
+        }
+        printf("screen: window %dx%d\n", w, h);
+    } else {
+        SDL_DisplayMode closest, previous;
+        const SDL_DisplayMode* mode = NULL;
+        const SDL_DisplayMode* old = SDL_GetWindowFullscreenMode(sdl3_window);
+        SDL_zero(previous);
+        if (old) previous = *old;
+        if (screen == 1) {
+            const SDL_DisplayID display = Sfa2Display();
+            if (w == 0 && h == 0) {
+                const SDL_DisplayMode* desktop = SDL_GetDesktopDisplayMode(display);
+                if (!desktop) {
+                    WARNF("screen: no desktop mode: %s", SDL_GetError());
+                    return -1;
+                }
+                w = desktop->w;
+                h = desktop->h;
+            }
+            if (!SDL_GetClosestFullscreenDisplayMode(display, w, h, 0.0f, false, &closest)) {
+                WARNF("screen: no fullscreen mode near %dx%d: %s", w, h, SDL_GetError());
+                return -1;
+            }
+            mode = &closest;
+        }
+        if (!SDL_SetWindowFullscreenMode(sdl3_window, mode) || !SDL_SetWindowFullscreen(sdl3_window, true)) {
+            WARNF("screen: cannot enter fullscreen: %s", SDL_GetError());
+            SDL_SetWindowFullscreenMode(sdl3_window, old ? &previous : NULL);
+            return -1;
+        }
+        is_fullscreen = true;
+        if (shown) {
+            SDL_SyncWindow(sdl3_window);
+            SDL_GetWindowSizeInPixels(sdl3_window, &wnd_size_in_pixels.w, &wnd_size_in_pixels.h);
+        }
+        if (mode) printf("screen: fullscreen %dx%d\n", closest.w, closest.h);
+        else printf("screen: borderless\n");
+    }
+    fflush(stdout);
+    return 0;
+}
+/* Called as the window is first shown (after PsyZ has set its size): enters the fullscreen that was asked for. */
+static void Sfa2ApplyPendingScreen(void) {
+    if (!sfa2_screen_set) return;
+    if (sfa2_screen == 0) {
+        printf("screen: window %dx%d\n", sfa2_win_w, sfa2_win_h);
+        fflush(stdout);
+    } else if (Sfa2ApplyScreen(sfa2_screen, sfa2_fs_w, sfa2_fs_h, 0) < 0) {
+        sfa2_screen = 0;
+        printf("screen: window %dx%d (fullscreen refused)\n", sfa2_win_w, sfa2_win_h);
+        fflush(stdout);
+    }
+}
+int Psyz_Sfa2SetScreen(int screen, int w, int h) {
+    if (screen < 0 || screen > 2) return -1;
+    if (screen == 0 && (w <= 0 || h <= 0)) return -1;
+    if (screen == 1 && (w < 0 || h < 0 || (w == 0) != (h == 0))) return -1;
+    if (is_window_visible) {
+        if (!sdl3_window || Sfa2ApplyScreen(screen, w, h, 1) < 0) return -1;
+    }
+    sfa2_screen = screen;
+    sfa2_screen_set = 1;
+    if (screen == 0) {
+        sfa2_win_w = w;
+        sfa2_win_h = h;
+    } else if (screen == 1) {
+        sfa2_fs_w = w;
+        sfa2_fs_h = h;
+    }
+    return 0;
+}
+int Psyz_Sfa2GetScreen(void) {
+    if (!is_window_visible) return sfa2_screen;
+    return is_fullscreen ? (sfa2_screen ? sfa2_screen : 1) : 0;
+}
+int Psyz_Sfa2DesktopSize(int* w, int* h) {
+    const SDL_DisplayMode* desktop;
+    if (!sdl3_window) return -1;
+    desktop = SDL_GetDesktopDisplayMode(Sfa2Display());
+    if (!desktop) return -1;
+    *w = desktop->w;
+    *h = desktop->h;
+    return 0;
+}
+static int Sfa2ModeOrder(const void* a, const void* b) {
+    const int* x = a;
+    const int* y = b;
+    const long long area_x = (long long)x[0] * x[1], area_y = (long long)y[0] * y[1];
+    if (area_x != area_y) return area_x < area_y ? 1 : -1;
+    return x[0] < y[0] ? 1 : x[0] > y[0] ? -1 : 0;
+}
+int Psyz_Sfa2FullscreenModes(int* wh, int max) {
+    int count = 0, n = 0;
+    SDL_DisplayMode** modes;
+    int* list;
+    if (!sdl3_window || max <= 0) return 0;
+    modes = SDL_GetFullscreenDisplayModes(Sfa2Display(), &count);
+    if (!modes) return 0;
+    list = malloc(sizeof(int) * 2 * (size_t)(count > 0 ? count : 1));
+    if (!list) {
+        SDL_free(modes);
+        return 0;
+    }
+    for (int i = 0; i < count; i++) {
+        int seen = 0;
+        for (int j = 0; j < n && !seen; j++) seen = list[2 * j] == modes[i]->w && list[2 * j + 1] == modes[i]->h;
+        if (seen) continue;
+        list[2 * n] = modes[i]->w;
+        list[2 * n + 1] = modes[i]->h;
+        n++;
+    }
+    qsort(list, (size_t)n, 2 * sizeof(int), Sfa2ModeOrder);
+    if (n > max) n = max;
+    memcpy(wh, list, sizeof(int) * 2 * (size_t)n);
+    free(list);
+    SDL_free(modes);
+    return n;
+}
