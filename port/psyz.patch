+void Psyz_Sfa2SetPixelPerfectUi(int enabled) { sfa2_pixel_perfect_ui = !!enabled; }
+static int sfa2_min_set, sfa2_min_w, sfa2_min_h;
+static SDL_Rect sfa2_last_dst = {-1,-1,-1,-1};
+static int Sfa2ArcadeActive(void) {
+    return sfa2_arcade_canvas && !display_rgb24 && !debug_show_vram;
+}
+int Psyz_Sfa2ExperimentalVideoAvailable(void) { return 1; }
+void Psyz_Sfa2SetArcadeCanvas(int enabled) {
+    enabled = !!enabled;
+    if (sfa2_arcade_canvas == enabled) return;
+    sfa2_arcade_canvas = enabled;
+    sfa2_last_dst.w = -1;
+    if (sdl3_window) {
+        if (enabled && !sfa2_min_set) {
+            SDL_GetWindowMinimumSize(sdl3_window,&sfa2_min_w,&sfa2_min_h);
+            SDL_SetWindowMinimumSize(sdl3_window,PORT_ARCADE_W,288);
+            sfa2_min_set = 1;
+        } else if (!enabled && sfa2_min_set) {
+            SDL_SetWindowMinimumSize(sdl3_window,sfa2_min_w,sfa2_min_h);
+            sfa2_min_set = 0;
+        }
+    }
+    printf("arcade-video: %s\n",enabled ? "384x224 active canvas, arcade 4:3 presentation" : "original presentation for other display mode");
+    fflush(stdout);
+}
